{
  "name": "kaskadyor-uz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kaskadyor — Toshkentdagi moto ekipirovka va ehtiyot qismlar do‘koni uchun bir sahifali brend sayt (React 19, Vite, TypeScript, Tailwind CSS 4, Motion; prerender qilingan statik build).",
  "homepage": "https://kaskadyor.uz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismoillooff/kaskadyor.uz.git"
  },
  "author": "Hayotbek Ismoilov (Ismoillooff) (https://ismoillooff.uz)",
  "keywords": [
    "kaskadyor",
    "moto",
    "motorcycle",
    "landing-page",
    "react",
    "vite",
    "typescript",
    "tailwindcss",
    "prerender",
    "uzbekistan"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/prune-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
